# Supabase (istemci tarafı — anon anahtar herkese açık olabilir, RLS korur)
VITE_SUPABASE_URL=https://PROJENIZ.supabase.co
VITE_SUPABASE_ANON_KEY=anon-anahtariniz

# Not: Cloudflare hesap kodu gizli değildir ve src/config.js'teki CF_CODE'dan okunur (TEK yer).

# Google ile giriş (isteğe bağlı) — YALNIZCA yerelde config.toml provider'ı için.
# Üretimde Google Client ID/Secret Supabase panelinden girilir (bkz. README 2b).
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_SECRET=GOCSPX-...

# Edge Function secret'ları — .env'e DEĞİL, Supabase'e tanımlanır (ASLA istemciye koyma):
#   supabase secrets set CF_ACCOUNT_ID=cloudflare-hesap-id
#   supabase secrets set CF_API_TOKEN=stream-yetkili-api-token
#   supabase secrets set CF_WEBHOOK_SECRET=webhook-sirri
#   supabase secrets set RESEND_API_KEY=re_...            (bildirim e-postaları)
#   supabase secrets set MAIL_FROM="Latent <bildirim@alanadiniz.com>"
#   supabase secrets set SITE_URL=https://latent.example
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...     (AI ön-eleme — isteğe bağlı)
