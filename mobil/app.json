{
  "expo": {
    "name": "Vaelo",
    "slug": "vaelo",
    "scheme": "vaelo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0B",
    "android": {
      "package": "app.vaelo.mobil"
    },
    "ios": {
      "bundleIdentifier": "app.vaelo.mobil"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vaelo needs access to your photos so you can submit artwork to the weekly Art contest."
        }
      ],
      "./plugins/withFmtFix.js",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "f55d2084-f754-4b7d-b3d5-8b84a64341a6"
      }
    }
  }
}
